# Copy to .env.local (git-ignored) for local development.
# Only the public anon (publishable) key belongs here. It is shipped to every
# browser by design; row level security is what protects the data.
# NEVER put a service_role / secret key in any VITE_* variable: Vite embeds
# those in the public JavaScript bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
